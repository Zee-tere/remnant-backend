{
  "Rules": [
    {
      "ID": "do-not-expire-db-managed-pending-uploads",
      "Status": "Disabled",
      "Filter": {
        "And": {
          "Prefix": "listings/",
          "Tags": [
            { "Key": "remnant-status", "Value": "pending" }
          ]
        }
      },
      "Expiration": { "Days": 1 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    },
    {
      "ID": "expire-replaced-listing-images",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "listings/",
          "Tags": [
            { "Key": "remnant-status", "Value": "orphaned" }
          ]
        }
      },
      "Expiration": { "Days": 7 }
    }
  ]
}
